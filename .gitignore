# Build & Output Directories
target/
build/
bin/
out/
dist/
*.dir/

# Compiled Binaries & Libraries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.exp
*.ilk
*.pdb
*.obj
*.o

# SPIR-V Bytecode & Caches
#
# Compiled .spv files are build byproducts (generated from the .comp sources
# by the vulkan_shaders CMake target), so they are ignored.
#
# The exception is shaders/compute/*.spv, which are intentionally tracked:
# they are embedded into src/shaders_embedded.hpp by scripts/embed_shaders.py,
# and keeping them in version control lets a checkout build without
# glslangValidator installed.
*.spv
!shaders/compute/*.spv
*.spv.cache
*.spv.tmp

# Caches & Compiler Database
.cache/
compile_commands.json

# IDE & Editor Metadata
.vscode/
.idea/
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user
*.suo

# System, Crash & Core Dumps
/core
core.*
*.dmp
*.core

# Logs and Runtime Traces
*.log
*.trace
logs/

# Secrets, Credentials & Environment
.env
.env.*
*.key
*.token
*.pem
*.pfx
secrets/
# Provider credentials and local-only runners (never commit)
quantumrings.conf
sdk-key-*.json
oq.py
.local/

# Python & Testing Caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Swap and Temporary Files
*.tmp
*.bin
*.swp
*.bak
*.db
cq_test_swap.bin

# bulky raw upstream dumps (see research/v2_4/evidence/README.md)
research/v2_4/evidence/openai_math_tree.json
research/v2_4/evidence/*.b64
.playwright-mcp/
