#version 450
#extension GL_ARB_gpu_shader_int64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct ComplexAmp {
    int real_val;
    int imag_val;
};

layout(std430, binding = 0) readonly buffer BufferA {
    ComplexAmp data_a[];
};

layout(std430, binding = 1) readonly buffer BufferB {
    ComplexAmp data_b[];
};

layout(std430, binding = 2) writeonly buffer BufferC {
    ComplexAmp data_c[];
};

layout(push_constant) uniform ContractConstants {
    uint dim_m;
    uint dim_k;
    uint dim_n;
} cc;

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    if (row >= cc.dim_m || col >= cc.dim_n) return;

    int64_t sum_real = 0;
    int64_t sum_imag = 0;

    for (uint k = 0u; k < cc.dim_k; ++k) {
        ComplexAmp a = data_a[row * cc.dim_k + k];
        ComplexAmp b = data_b[k * cc.dim_n + col];

        // Complex multiplication in Q30
        int64_t ar = int64_t(a.real_val);
        int64_t ai = int64_t(a.imag_val);
        int64_t br = int64_t(b.real_val);
        int64_t bi = int64_t(b.imag_val);

        sum_real += (ar * br - ai * bi) >> 30;
        sum_imag += (ar * bi + ai * br) >> 30;
    }

    uint out_idx = row * cc.dim_n + col;
    data_c[out_idx].real_val = int(sum_real);
    data_c[out_idx].imag_val = int(sum_imag);
}
