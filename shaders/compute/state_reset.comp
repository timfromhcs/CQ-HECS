#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ComplexAmp {
    int real_val;
    int imag_val;
};

layout(std430, binding = 0) buffer StateBuffer {
    ComplexAmp amplitudes[];
};

layout(push_constant) uniform ResetConstants {
    uint total_elements;
    uint target_basis; // 0 for |0>, 1 for |1>
} rc;

const int FIXED_ONE = 1073741824; // 2^30 (1.0 in Q30)

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= rc.total_elements) return;

    // For site local state: index 0 is |0>, index 1 is |1>
    if (gid % 2u == rc.target_basis) {
        amplitudes[gid].real_val = FIXED_ONE;
        amplitudes[gid].imag_val = 0;
    } else {
        amplitudes[gid].real_val = 0;
        amplitudes[gid].imag_val = 0;
    }
}
