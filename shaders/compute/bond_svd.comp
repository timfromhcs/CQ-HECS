#version 450
#extension GL_ARB_gpu_shader_int64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ComplexAmp {
    int real_val;
    int imag_val;
};

layout(std430, binding = 0) buffer MatrixA {
    ComplexAmp mat_a[];
};

layout(std430, binding = 1) buffer MatrixU {
    ComplexAmp mat_u[];
};

layout(std430, binding = 2) buffer MatrixV {
    ComplexAmp mat_v[];
};

layout(push_constant) uniform BondConstants {
    uint rows;
    uint cols;
    uint p_idx;
    uint q_idx;
    int cos_val; // Q30
    int sin_val; // Q30
} bc;

int fixed_mul(int a, int b) {
    int64_t prod = int64_t(a) * int64_t(b);
    return int(prod >> 30);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Apply Jacobi rotation on column pair (p_idx, q_idx)
    if (idx < bc.rows) {
        uint p_elem = idx * bc.cols + bc.p_idx;
        uint q_elem = idx * bc.cols + bc.q_idx;

        ComplexAmp ap = mat_a[p_elem];
        ComplexAmp aq = mat_a[q_elem];

        int new_pr = fixed_mul(ap.real_val, bc.cos_val) - fixed_mul(aq.real_val, bc.sin_val);
        int new_pi = fixed_mul(ap.imag_val, bc.cos_val) - fixed_mul(aq.imag_val, bc.sin_val);

        int new_qr = fixed_mul(ap.real_val, bc.sin_val) + fixed_mul(aq.real_val, bc.cos_val);
        int new_qi = fixed_mul(ap.imag_val, bc.sin_val) + fixed_mul(aq.imag_val, bc.cos_val);

        mat_a[p_elem].real_val = new_pr;
        mat_a[p_elem].imag_val = new_pi;
        mat_a[q_elem].real_val = new_qr;
        mat_a[q_elem].imag_val = new_qi;
    }
}
