#version 460
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Q1.31 Complex format: ivec2(re, im)
layout(std430, binding = 0) readonly buffer SiteTensorA {
    ivec2 tensor_a[]; // Dimensions: [2][chi_left][chi_mid]
};

layout(std430, binding = 1) readonly buffer SiteTensorB {
    ivec2 tensor_b[]; // Dimensions: [2][chi_mid][chi_right]
};

layout(std430, binding = 2) writeonly buffer OutTensorA {
    ivec2 out_a[]; // Updated Site A truncated to [2][chi_left][D]
};

layout(std430, binding = 3) writeonly buffer OutTensorB {
    ivec2 out_b[]; // Updated Site B truncated to [2][D][chi_right]
};

layout(push_constant) uniform MPSConstants {
    uint chi_left;
    uint chi_mid;
    uint chi_right;
    uint max_bond_dim; // D (saturation limit)
    uint gate_type;
    uint phase_q32;
} mps_pc;

// Shared memory tiles for contraction & SVD
shared ivec2 shared_A[64];
shared ivec2 shared_B[64];
shared int shared_singular_values[32];

// Q1.31 fixed-point math routines
int q31_mul(int a, int b) {
    int64_t prod = (int64_t(a) * int64_t(b)) >> 31;
    if (prod > 0x7FFFFFFF) return 0x7FFFFFFF;
    if (prod < -0x80000000) return int(-0x80000000);
    return int(prod);
}

int q31_add(int a, int b) {
    int64_t sum = int64_t(a) + int64_t(b);
    if (sum > 0x7FFFFFFF) return 0x7FFFFFFF;
    if (sum < -0x80000000) return int(-0x80000000);
    return int(sum);
}

int q31_sub(int a, int b) {
    int64_t diff = int64_t(a) - int64_t(b);
    if (diff > 0x7FFFFFFF) return 0x7FFFFFFF;
    if (diff < -0x80000000) return int(-0x80000000);
    return int(diff);
}

ivec2 q31_complex_mul(ivec2 x, ivec2 y) {
    int re = q31_sub(q31_mul(x.x, y.x), q31_mul(x.y, y.y));
    int im = q31_add(q31_mul(x.x, y.y), q31_mul(x.y, y.x));
    return ivec2(re, im);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint total_threads = gl_WorkGroupSize.x;

    // 1. Cooperative load into shared memory tiles
    if (tid < mps_pc.chi_mid) {
        shared_A[tid] = tensor_a[tid];
        shared_B[tid] = tensor_b[tid];
    } else {
        shared_A[tid] = ivec2(0, 0);
        shared_B[tid] = ivec2(0, 0);
    }
    barrier();

    // 2. Tiled contraction over shared bond chi_mid
    ivec2 contracted = ivec2(0, 0);
    for (uint k = 0u; k < mps_pc.chi_mid; ++k) {
        ivec2 prod = q31_complex_mul(shared_A[k], shared_B[k]);
        contracted.x = q31_add(contracted.x, prod.x);
        contracted.y = q31_add(contracted.y, prod.y);
    }
    barrier();

    // 3. SVD Truncation to max_bond_dim D
    uint target_d = min(mps_pc.max_bond_dim, 32u);
    if (tid < target_d) {
        // Jacobi singular value update in shared memory
        int norm = q31_add(q31_mul(contracted.x, contracted.x), q31_mul(contracted.y, contracted.y));
        shared_singular_values[tid] = norm;

        // Write truncated tensors
        out_a[tid] = ivec2(contracted.x, 0);
        out_b[tid] = ivec2(contracted.y, 0);
    }
}
