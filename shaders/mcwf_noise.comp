#version 460
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Q1.31 Complex format: ivec2(re, im)
layout(std430, binding = 0) buffer StateBuffer {
    ivec2 state_amplitudes[];
};

layout(push_constant) uniform NoiseConstants {
    uint target_qubit;
    uint seed;
    uint iteration;
    uint gamma_t1_q31;  // T1 amplitude damping probability in Q1.31
    uint gamma_t2_q31;  // T2* dephasing probability in Q1.31
} pc;

// Philox-4x32-10 Constants
const uint PHILOX_M0 = 0xD2511F53u;
const uint PHILOX_M1 = 0xCD9E8D57u;
const uint PHILOX_W0 = 0x9E3779B9u;
const uint PHILOX_W1 = 0xBB67AE85u;

uvec4 philox4x32_round(uvec4 ctr, uvec2 key) {
    uint hi0 = uint((uint64_t(ctr.x) * uint64_t(PHILOX_M0)) >> 32);
    uint lo0 = ctr.x * PHILOX_M0;
    uint hi1 = uint((uint64_t(ctr.z) * uint64_t(PHILOX_M1)) >> 32);
    uint lo1 = ctr.z * PHILOX_M1;

    return uvec4(
        hi1 ^ ctr.y ^ key.x,
        lo1,
        hi0 ^ ctr.w ^ key.y,
        lo0
    );
}

uvec4 philox4x32_10(uvec4 ctr, uvec2 key) {
    for (int r = 0; r < 10; ++r) {
        ctr = philox4x32_round(ctr, key);
        key.x += PHILOX_W0;
        key.y += PHILOX_W1;
    }
    return ctr;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    ivec2 amp = state_amplitudes[gid];

    // Counter-based Philox PRNG initialization
    uvec4 ctr = uvec4(gid, pc.iteration, 0u, 0u);
    uvec2 key = uvec2(pc.seed, 0x12345678u);
    uvec4 rnd = philox4x32_10(ctr, key);

    uint mask = 1u << pc.target_qubit;
    bool is_excited = (gid & mask) != 0u;

    // T1 Relaxation (Amplitude Damping): |1> decays to |0> with probability gamma_t1
    uint rand_t1 = rnd.x & 0x7FFFFFFFu; // Random Q1.31 number in [0, 1)
    if (is_excited && rand_t1 < pc.gamma_t1_q31) {
        // Quantum jump: decay to |0>
        uint ground_gid = gid & ~mask;
        state_amplitudes[ground_gid] = amp;
        state_amplitudes[gid] = ivec2(0, 0);
        return;
    }

    // T2* Dephasing: random phase flip with probability gamma_t2
    uint rand_t2 = rnd.y & 0x7FFFFFFFu;
    if (is_excited && rand_t2 < pc.gamma_t2_q31) {
        // Phase jump: Z operation
        state_amplitudes[gid] = ivec2(-amp.x, -amp.y);
    }
}
